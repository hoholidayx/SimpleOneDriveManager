# Microsoft Entra 应用注册 > Web 平台。选择支持个人账号和任意组织目录。
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
# 0.0.0.0 允许本机与局域网访问；改为 127.0.0.1 可限制为仅本机。
HOST=0.0.0.0
# 开发环境使用 http://localhost:5173；本机生产环境使用 http://localhost:3000。
APP_ORIGIN=http://localhost:3000
# 在微软控制台注册该 Web 回调地址。其他设备 OAuth 登录需同域名的 HTTPS 页面和回调。
MS_REDIRECT_URI=http://localhost:3000/api/auth/callback
PORT=3000
# 运行 npm run setup 自动生成，修改此密钥会导致已有授权缓存无法读取。
TOKEN_ENCRYPTION_KEY=
